PROGRAM CROSS_GROUP_ALL
VAR n,s:INTEGER done:BOOLEAN p,q:XYZWPR c:CONFIG
BEGIN
 IF UNINIT(done) THEN
CNV_STR_CONF('N',c,s)
p=POS(10,20,30,0,0,0,c)
q=POS(40,50,60,0,0,0,c)
n=7
ATTACH
WITH $SPEED=25,$ROTSPEED=10,$MOTYPE=STRAIGHT,$UFRAME=p,$UTOOL=q,$USE_CONFIG=FALSE,$TERMTYPE=FINE,$SEGTERMTYPE=NODECEL,$ORIENT_TYPE=RSWORLD,$DECELTOL=50,$USEMAXACCEL=TRUE,$ACCEL_OVRD=125,$ACCU_NUM=3,$SEG_TIME=40,$TIME_SHIFT=10,$CONTAXISVEL=-25.5,$CNSTNT_PATH=TRUE,$DYN_I_COMP=FALSE,$USE_CARTACC=TRUE,$USERELACCEL=TRUE,$USETIMESHFT=TRUE,$SPEED[2]=25,$ROTSPEED[2]=10,$MOTYPE[2]=STRAIGHT,$UFRAME[2]=p,$UTOOL[2]=q,$USE_CONFIG[2]=FALSE,$TERMTYPE[2]=FINE,$SEGTERMTYPE[2]=NODECEL,$ORIENT_TYPE[2]=RSWORLD,$DECELTOL[2]=50,$USEMAXACCEL[2]=TRUE,$ACCEL_OVRD[2]=125,$ACCU_NUM[2]=3,$SEG_TIME[2]=40,$TIME_SHIFT[2]=10,$CONTAXISVEL[2]=-25.5,$CNSTNT_PATH[2]=TRUE,$DYN_I_COMP[2]=FALSE,$USE_CARTACC[2]=TRUE,$USERELACCEL[2]=TRUE,$USETIMESHFT[2]=TRUE
MOVE TO p
RELEASE
 done=TRUE
 ENDIF
END CROSS_GROUP_ALL
