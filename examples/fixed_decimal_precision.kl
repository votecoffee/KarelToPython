PROGRAM fixed_decimal_precision
%NOLOCKGROUP
VAR
  parts: ARRAY[3] OF STRING[24]
  negative: STRING[20]
  small: STRING[5]
  restored: REAL

ROUTINE build: ARRAY OF STRING[24]
VAR values: ARRAY[3] OF STRING[24]
BEGIN
  CNV_REAL_STR(1.125,1,3,values[1])
  CNV_REAL_STR(0.0001220703125,1,13,values[2])
  CNV_REAL_STR(0.0,1,6,values[3])
  RETURN values
END build

BEGIN
  parts=build
  CNV_REAL_STR(-1.125,1,6,negative)
  CNV_REAL_STR(1.125,1,3,small)
  CNV_STR_REAL(SUB_STR(parts[2],2,STR_LEN(parts[2])-1),restored)
END fixed_decimal_precision
