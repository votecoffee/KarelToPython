PROGRAM MAIN
TYPE node_t=STRUCTURE common:COMMON_ASSOC axes:GROUP_ASSOC ENDSTRUCTURE
VAR track:PATH NODEDATA=node_t axes:ARRAY[2]OF GROUP_ASSOC done:BOOLEAN
ROUTINE fill(track_data:PATH NODEDATA=node_t;values:ARRAY OF GROUP_ASSOC) FROM LIB
BEGIN
  IF UNINIT(done) THEN fill(track,axes) done=TRUE ENDIF
END MAIN
