PROGRAM LIB

VAR jobs:ARRAY[2]OF QUEUE_TYPE buffers:ARRAY[2,3]OF INTEGER
ROUTINE work:INTEGER
VAR status,seq:INTEGER
BEGIN
  INIT_QUEUE(jobs[2]) APPEND_QUEUE(23,jobs[2],buffers[2],seq,status) SAVE('LIB','LIB.VR',status) MODIFY_QUEUE(99,1,jobs[2],buffers[2],status) LOAD('LIB.VR',0,status) RETURN(buffers[2,1])
END work
BEGIN END LIB
