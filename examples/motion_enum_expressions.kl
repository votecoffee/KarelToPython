PROGRAM MOTION_ENUM_EXPRESSIONS
VAR fine,linear,rsworld,n:INTEGER done:BOOLEAN
BEGIN
  IF UNINIT(done) THEN
    fine=9 linear=10 rsworld=11
    ATTACH
    WITH $TERMTYPE=FINE+1,$ORIENT_TYPE=(RSWORLD+1),$MOTYPE=STRAIGHT
    MOVE AWAY 1
    RELEASE
    n=fine+linear+rsworld done=TRUE
  ENDIF
END MOTION_ENUM_EXPRESSIONS
