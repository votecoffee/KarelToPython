PROGRAM PATH_DRAM_ARCHIVE
TYPE node_t=STRUCTURE value:INTEGER ENDSTRUCTURE
     header_t=STRUCTURE count:INTEGER ENDSTRUCTURE
     route_t=PATH NODEDATA=node_t PATHHEADER=header_t
VAR route:route_t value:INTEGER done:BOOLEAN
ROUTINE transact
VAR status:INTEGER
BEGIN
  APPEND_NODE(route,status)
  route[1].value=42 route.count=1
  SAVE_DRAM('PATH_DRAM_ARCHIVE',status)
  value=route[1].value
END transact
BEGIN
  IF UNINIT(done) THEN
    transact
    done=TRUE
  ENDIF
END PATH_DRAM_ARCHIVE
