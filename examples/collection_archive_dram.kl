PROGRAM COLLECTION_ARCHIVE_DRAM

VAR jobs:ARRAY[2]OF QUEUE_TYPE buffers:ARRAY[2,3]OF INTEGER value:INTEGER done:BOOLEAN
ROUTINE transact
VAR status,seq:INTEGER
BEGIN
  INIT_QUEUE(jobs[2]) APPEND_QUEUE(42,jobs[2],buffers[2],seq,status) SAVE_DRAM('COLLECTION_ARCHIVE_DRAM',status) value=buffers[2,1]
END transact
BEGIN
  IF UNINIT(done) THEN
    transact
    done=TRUE
  ENDIF
END COLLECTION_ARCHIVE_DRAM
