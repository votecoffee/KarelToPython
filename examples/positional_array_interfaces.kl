PROGRAM ARRAYINTERFACE
VAR cfg:CONFIG status:INTEGER a:ARRAY[2]OF XYZWPR matrices:ARRAY[2]OF POSITION result:ARRAY[2]OF XYZWPREXT done:BOOLEAN
ROUTINE shifted(points:ARRAY OF POSITION):ARRAY OF XYZWPREXT
BEGIN
  points[1].location.x=points[1].location.x+10
  RETURN points
END shifted
BEGIN
  IF UNINIT(done) THEN
    CNV_STR_CONF('N',cfg,status)
    a[1]=POS(1,2,3,0,0,90,cfg)
    a[2]=POS(4,5,6,0,0,0,cfg)
    matrices=a
    result=shifted(a)
    done=TRUE
  ENDIF
END ARRAYINTERFACE
