PROGRAM DISC_PRIVATE
VAR source:ARRAY[2,2]OF INTEGER total:REAL after:INTEGER
ROUTINE consume(p:ARRAY[*,*]OF REAL)
VAR i,j:INTEGER
BEGIN
  total=0
  FOR i=1 TO ARRAY_LEN(p,1) DO
    FOR j=1 TO ARRAY_LEN(p,2) DO total=total+p[i,j] ENDFOR
  ENDFOR
  p[1,1]=99.5
END consume
BEGIN
  source[1,1]=1 source[1,2]=2 source[2,1]=3 source[2,2]=4
  consume((source))
  after=source[1,1]
END DISC_PRIVATE
