PROGRAM NOWAIT_CLAUSES_TEMPORAL
VAR n:INTEGER done:BOOLEAN
BEGIN
 IF UNINIT(done) THEN
  n=0 ATTACH
  WITH $SPEED=20 MOVE AWAY 1 NOWAIT,
   WHEN AT NODE[0] DO n=1
   WHEN TIME 3 BEFORE NODE[1] DO n=n*10+2
   WHEN AT NODE[1] DO n=n*10+3
  ENDMOVE
  DELAY 40 RELEASE done=TRUE
 ENDIF
END NOWAIT_CLAUSES_TEMPORAL
