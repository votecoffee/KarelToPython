PROGRAM SOCKET_WAIT_TEXT
VAR n,m,status:INTEGER done:BOOLEAN
ROUTINE exchange
VAR channel:FILE
BEGIN
 OPEN FILE channel('RW','S1:')
 READ channel(n,m,CR)
 WRITE channel('ack',CR)
 status=IO_STATUS(channel)
 CLOSE FILE channel
END exchange
BEGIN
 IF UNINIT(done) THEN exchange() done=TRUE ENDIF
END SOCKET_WAIT_TEXT
