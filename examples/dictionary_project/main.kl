PROGRAM MAIN
VAR output:FILE
    status,result,count:INTEGER
ROUTINE format_it(stream:FILE):INTEGER FROM LIB
BEGIN
  ADD_DICT('labels','USER',DP_DEFAULT,DP_DRAM,status)
  DEF_WINDOW('LOG',1,16,WD_COM_CURSR,status)
  ATT_WINDOW_S('LOG','SYS',1,1,status)
  OPEN FILE output('RW','WD:LOG')
  SET_CURSOR(output,1,1,status)
  count=42
  result=format_it(output)
  CLOSE FILE output
END MAIN
