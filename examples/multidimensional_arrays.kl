PROGRAM MULTIDIMENSIONAL_ARRAYS
%NOLOCKGROUP
VAR
  TABLE, SAVED: ARRAY[2,3] OF INTEGER
  CUBE: ARRAY[2,2,2] OF INTEGER
  WORDS: ARRAY[2,2] OF STRING[3]
  SEEN_AFTER_COPY, FOUND_COORDINATE: INTEGER
ROUTINE FILL(P: ARRAY[*,*] OF INTEGER; ROWS,COLUMNS: INTEGER)
VAR R,C: INTEGER
BEGIN
  FOR R = 1 TO ROWS DO
    FOR C = 1 TO COLUMNS DO
      P[R,C] = R * 10 + C
    ENDFOR
  ENDFOR
END FILL
ROUTINE COPY_WITH_REFERENCE(P,Q: ARRAY[*,*] OF INTEGER; ELEMENT: INTEGER)
BEGIN
  P = Q
  SEEN_AFTER_COPY = ELEMENT
  ELEMENT = 99
END COPY_WITH_REFERENCE
ROUTINE FIND_VALUE(P: ARRAY[*,*] OF INTEGER; VALUE: INTEGER): INTEGER
VAR R,C: INTEGER
BEGIN
  FOR R = 1 TO 2 DO
    FOR C = 1 TO 3 DO
      IF P[R,C] = VALUE THEN RETURN R * 10 + C ENDIF
    ENDFOR
  ENDFOR
  RETURN 0
END FIND_VALUE
ROUTINE FILL_CUBE(P: ARRAY[*,*,*] OF INTEGER)
VAR I,J,K: INTEGER
BEGIN
  FOR I = 1 TO 2 DO
    FOR J = 1 TO 2 DO
      FOR K = 1 TO 2 DO
        P[I,J,K] = I * 100 + J * 10 + K
      ENDFOR
    ENDFOR
  ENDFOR
END FILL_CUBE
ROUTINE LABEL(P: ARRAY[*,*] OF STRING)
BEGIN
  P[1,2] = 'abcdef'
  P[2,1] = 'xy'
END LABEL
BEGIN
  FILL(TABLE,2,3)
  SAVED = TABLE
  TABLE[2,3] = 0
  COPY_WITH_REFERENCE(TABLE,SAVED,TABLE[2,3])
  FOUND_COORDINATE = FIND_VALUE(TABLE,99)
  FILL_CUBE(CUBE)
  LABEL(WORDS)
END MULTIDIMENSIONAL_ARRAYS
