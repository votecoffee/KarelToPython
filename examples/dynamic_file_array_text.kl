PROGRAM DYNAMIC_FILE_ARRAY_TEXT

VAR entry,status,value:INTEGER done:BOOLEAN
ROUTINE work(a:ARRAY OF FILE)
BEGIN
  OPEN FILE a[1]('WO','one') WRITE a[1](17,CR) CLOSE FILE a[1]
  OPEN FILE a[2]('WO','two') WRITE a[2](19,CR) status=IO_STATUS(a[2]) CLOSE FILE a[2]
  value=36
END work
BEGIN
  IF UNINIT(done) THEN
    CREATE_VAR('CACHE','ITEM','','ARRAY OF FILE',0,2,0,0,status)
    done=TRUE
  ENDIF
  work(BYNAME('CACHE','ITEM',entry))
END DYNAMIC_FILE_ARRAY_TEXT
