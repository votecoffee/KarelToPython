PROGRAM BLOCKING_CLAUSES_TEMPORAL
VAR n:INTEGER done:BOOLEAN
BEGIN
 IF UNINIT(done) THEN
  n=0
  ATTACH
  MOVE AWAY 1 NOWAIT
  MOVE AWAY 2,
   WHEN AT NODE[0] DO n=1
   WHEN TIME 5 BEFORE NODE[1] DO n=n*10+2
   WHEN AT NODE[1] DO n=n*10+3
  ENDMOVE
  RELEASE
  done=TRUE
 ENDIF
END BLOCKING_CLAUSES_TEMPORAL
