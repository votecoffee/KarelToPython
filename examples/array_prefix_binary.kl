PROGRAM ARRAY_PREFIX_BINARY
VAR matrix:ARRAY[2,2]OF INTEGER row:ARRAY[2]OF INTEGER value:INTEGER done:BOOLEAN
ROUTINE work
VAR f:FILE
BEGIN
  matrix[1,1]=7 matrix[1,2]=9
  OPEN FILE f('WB','output') WRITE f(matrix[1]::2) CLOSE FILE f
  OPEN FILE f('RB','output') READ f(row::2) CLOSE FILE f
  row[1]=42 value=row[1]+row[2]
END work
BEGIN IF UNINIT(done) THEN work done=TRUE ENDIF END ARRAY_PREFIX_BINARY
