PROGRAM STRUCT_DEMO
%NOLOCKGROUP
CONST SIZE = 2
TYPE
  ITEM_T = STRUCTURE
    COUNT: INTEGER
    LABEL: STRING[3]
  ENDSTRUCTURE
  RECORD_T = STRUCTURE
    ITEM: ITEM_T
    READY: BOOLEAN
    MEASUREMENT: REAL
    SLOTS: ARRAY[SIZE] OF INTEGER
  ENDSTRUCTURE
VAR
  SOURCE_RECORD, COPY_RECORD: RECORD_T
  SEEN_AFTER_COPY: INTEGER
  WAS_UNINITIALIZED: BOOLEAN
ROUTINE INITIALIZE(P: RECORD_T)
BEGIN
  P.ITEM.COUNT = 5
  P.ITEM.LABEL = 'abcdef'
  P.READY = TRUE
  P.MEASUREMENT = 2.5
  P.SLOTS[1] = 10
  P.SLOTS[2] = 20
END INITIALIZE
ROUTINE COPY_AND_CHANGE(P,Q: RECORD_T; SAVED_FIELD: INTEGER)
BEGIN
  P = Q
  SEEN_AFTER_COPY = SAVED_FIELD
  SAVED_FIELD = 99
END COPY_AND_CHANGE
BEGIN
  WAS_UNINITIALIZED = UNINIT(COPY_RECORD.ITEM.COUNT)
  INITIALIZE(SOURCE_RECORD)
  COPY_AND_CHANGE(COPY_RECORD,SOURCE_RECORD,COPY_RECORD.ITEM.COUNT)
  SOURCE_RECORD.ITEM.COUNT = 7
END STRUCT_DEMO
