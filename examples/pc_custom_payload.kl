PROGRAM PC_RAW
VAR
  buffer: ARRAY[5] OF BYTE
  status: INTEGER
  sent: BOOLEAN
BEGIN
  IF UNINIT(sent) THEN sent=FALSE ENDIF
  buffer[1]=0
  buffer[2]=0
  buffer[3]=9
  buffer[4]=255
  buffer[5]=1
  status=0
  IF NOT sent THEN
    SEND_DATAPC(33,buffer,status)
    IF status=0 THEN sent=TRUE ENDIF
  ENDIF
END PC_RAW
