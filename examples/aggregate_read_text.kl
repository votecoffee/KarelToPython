PROGRAM AGGREGATE_READ_TEXT
VAR values:ARRAY[2]OF INTEGER cfg:CONFIG status,value:INTEGER done:BOOLEAN
ROUTINE work
VAR f:FILE
BEGIN
  OPEN FILE f('RO','input')
  READ f(values,CR,cfg,CR)
  status=IO_STATUS(f)
  CLOSE FILE f
  value=values[1]+values[2]
END work
BEGIN
  IF UNINIT(done) THEN work done=TRUE ENDIF
END AGGREGATE_READ_TEXT
