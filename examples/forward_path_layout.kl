PROGRAM FORWARD_PATH_LAYOUT
TYPE route_t=PATH NODEDATA=node_t PATHHEADER=header_t
 node_t=STRUCTURE n:INTEGER ENDSTRUCTURE
 header_t=STRUCTURE total:INTEGER ENDSTRUCTURE
VAR route:route_t status:INTEGER done:BOOLEAN
BEGIN
 IF UNINIT(done) THEN route.total=1 APPEND_NODE(route,status) route[1].n=7 done=TRUE ENDIF
END FORWARD_PATH_LAYOUT
