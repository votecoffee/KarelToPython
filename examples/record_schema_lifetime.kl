PROGRAM RECORDLIFETIME
TYPE in_t=STRUCTURE count:INTEGER label:STRING[8] ENDSTRUCTURE
     out_t=STRUCTURE label:STRING[3] count:REAL ENDSTRUCTURE
VAR original:in_t result:out_t seen:REAL done:BOOLEAN
ROUTINE retain(value:out_t)
BEGIN
  CONDITION[1]: WHEN EVENT[1] DO value.count=99 seen=value.count ENDCONDITION
END retain
ROUTINE make:out_t
BEGIN
  FOR original.count=1 TO 2 DO RETURN original ENDFOR
  RETURN original
END make
BEGIN
  IF UNINIT(done) THEN
    original.count=7 original.label='abcdefgh'
    retain(original)
    ENABLE CONDITION[1] SIGNAL EVENT[1]
    result=make()
    done=TRUE
  ENDIF
END RECORDLIFETIME
