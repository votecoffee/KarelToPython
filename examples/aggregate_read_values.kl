PROGRAM AGGREGATE_READ_VALUES
TYPE packet_t=STRUCTURE values:ARRAY[2]OF INTEGER label:STRING[4] cfg:CONFIG ENDSTRUCTURE
VAR packet:packet_t value:INTEGER done:BOOLEAN
BEGIN
  IF UNINIT(done) THEN
    READ(packet,CR)
    value=packet.values[1]+packet.values[2]
    done=TRUE
  ENDIF
END AGGREGATE_READ_VALUES
