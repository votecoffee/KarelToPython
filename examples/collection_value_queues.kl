PROGRAM COLLECTION_VALUE_QUEUES

VAR source,target:ARRAY[2]OF QUEUE_TYPE buffer,extra:ARRAY[3]OF INTEGER seq,status:INTEGER done:BOOLEAN
ROUTINE extend(values:ARRAY OF QUEUE_TYPE):ARRAY OF QUEUE_TYPE
BEGIN APPEND_QUEUE(22,values[2],extra,seq,status) RETURN values END extend
BEGIN
  IF UNINIT(done) THEN
    INIT_QUEUE(source[1]) INIT_QUEUE(source[2]) APPEND_QUEUE(17,source[2],buffer,seq,status) target=extend((source))
    done=TRUE
  ENDIF
END COLLECTION_VALUE_QUEUES
