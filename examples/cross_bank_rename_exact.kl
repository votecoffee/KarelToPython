PROGRAM CROSS_BANK_RENAME_EXACT
VAR incoming,outgoing:INTEGER done:BOOLEAN
BEGIN
  IF UNINIT(done) THEN done=FALSE ENDIF
  IF NOT done THEN
    RENAME_FILE('source','PIP:BRIDGE.DAT',FALSE,incoming)
    RENAME_FILE('PIP:BRIDGE.DAT','result',TRUE,outgoing)
    done=TRUE
  ENDIF
END CROSS_BANK_RENAME_EXACT
