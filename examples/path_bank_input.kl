PROGRAM PATH_BANK_INPUT
TYPE node_t=STRUCTURE value:INTEGER ENDSTRUCTURE header_t=STRUCTURE count:INTEGER ENDSTRUCTURE route_t=PATH NODEDATA=node_t PATHHEADER=header_t
VAR paths:ARRAY[2]OF route_t value,status:INTEGER stream:FILE
BEGIN
  IF PATH_LEN(paths[1])=0 THEN APPEND_NODE(paths[1],status) ENDIF
  IF PATH_LEN(paths[2])=0 THEN APPEND_NODE(paths[2],status) ENDIF
  OPEN FILE stream('RB','input') READ stream(paths) CLOSE FILE stream
  value=paths[1][1].value+paths[2][1].value
END PATH_BANK_INPUT
