PROGRAM MAIN
VAR names:ARRAY[1]OF STRING[32] count,status,translation_status:INTEGER done:BOOLEAN
ROUTINE compile_src(result:INTEGER) FROM LIB
BEGIN IF UNINIT(done) THEN compile_src(translation_status) FILE_LIST('*.py',0,3,names,count,status) DELETE_FILE('child.py',FALSE,status) DELETE_FILE('child.LS',FALSE,status) done=TRUE ENDIF END MAIN
