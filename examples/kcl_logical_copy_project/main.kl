PROGRAM MAIN
TYPE node_t=STRUCTURE value:INTEGER ENDSTRUCTURE
     route_t=PATH NODEDATA=node_t
VAR source,result:route_t
    entry,status,answer:INTEGER
    done:BOOLEAN
ROUTINE copy_route:INTEGER FROM LIB
BEGIN
  IF UNINIT(done) THEN
    APPEND_NODE(source,status)
    source[1].value=17
    CREATE_VAR('','CACHED','','route_t',0,0,0,0,status,-1)
    answer=copy_route
    source[1].value=99
    GET_VAR(entry,'','CACHED',result,status)
    done=TRUE
  ENDIF
END MAIN
