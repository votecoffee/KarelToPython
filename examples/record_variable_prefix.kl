PROGRAM RECORDVARIABLEPREFIX
TYPE in_t=STRUCTURE count:INTEGER label:STRING[8] ENDSTRUCTURE out_t=STRUCTURE label:STRING[3] count:REAL ENDSTRUCTURE
 in_array=ARRAY[1,2]OF in_t out_row=ARRAY[3]OF out_t out_array=ARRAY[1]OF out_row
VAR original:in_array result,saved:out_array entry,status,first_entry:INTEGER done:BOOLEAN
BEGIN
  IF UNINIT(done) THEN
    original[1,1].count=1 original[1,1].label='abcdefgh'
    original[1,2].count=2 original[1,2].label='xy'
    result[1,3].count=99 result[1,3].label='old'
    GET_VAR(entry,'','ORIGINAL',result,status)
    first_entry=entry saved=result original[1,1].count=4
    SET_VAR(entry,'','RESULT',original,status)
    done=TRUE
  ENDIF
END RECORDVARIABLEPREFIX
