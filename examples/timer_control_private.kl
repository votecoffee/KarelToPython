PROGRAM TIMER_CONTROL_PRIVATE
TYPE row_t=STRUCTURE elapsed:INTEGER other:INTEGER ENDSTRUCTURE
VAR item:row_t result:INTEGER ready,done:BOOLEAN
ROUTINE stop_timer(value:INTEGER):BOOLEAN BEGIN DISCONNECT TIMER value RETURN value>0 END stop_timer
ROUTINE copy_item:row_t BEGIN RETURN item END copy_item
BEGIN
 IF UNINIT(done) THEN
  USING copy_item() DO
   CONNECT TIMER TO elapsed DELAY 32 ready=stop_timer(elapsed) elapsed=0 DELAY 9 result=elapsed
  ENDUSING
  done=TRUE
 ENDIF
END TIMER_CONTROL_PRIVATE
