PROGRAM PATH_BANK_BINARY
TYPE node_t=STRUCTURE value:INTEGER ENDSTRUCTURE header_t=STRUCTURE count:INTEGER ENDSTRUCTURE route_t=PATH NODEDATA=node_t PATHHEADER=header_t
VAR paths,target:ARRAY[2]OF route_t value,status:INTEGER stream:FILE
BEGIN
  IF PATH_LEN(paths[1])=0 THEN
    APPEND_NODE(paths[1],status) APPEND_NODE(paths[2],status) paths[1].count=1 paths[2].count=2 paths[1][1].value=7 paths[2][1].value=9
  ENDIF
  IF PATH_LEN(target[1])=0 THEN APPEND_NODE(target[1],status) ENDIF
  IF PATH_LEN(target[2])=0 THEN APPEND_NODE(target[2],status) ENDIF
  OPEN FILE stream('WB','output') WRITE stream(paths) CLOSE FILE stream
  OPEN FILE stream('RB','output') READ stream(target) CLOSE FILE stream
  value=target[1][1].value+target[2][1].value
END PATH_BANK_BINARY
