PROGRAM MAIN
TYPE header_t FROM LIBRARY=STRUCTURE count:INTEGER ENDSTRUCTURE
     route_t FROM LIBRARY=PATH PATHDATA=header_t NODEDATA=STD_PTH_NODE
VAR shared FROM LIBRARY:route_t
    display:DISP_DAT_T
    result:INTEGER
ROUTINE fill(data:PATH NODEDATA=STD_PTH_NODE PATHDATA=header_t; display:DISP_DAT_T):INTEGER FROM LIBRARY
BEGIN
  result=fill(shared,display)
END MAIN
