PROGRAM pythonic_array_shapes
CONST COLUMNS=3
TYPE row_t=ARRAY[COLUMNS] OF INTEGER
     matrix_t=ARRAY[2,COLUMNS] OF INTEGER
VAR
  named: matrix_t
  fixed,wild: ARRAY[2,COLUMNS] OF INTEGER
  row: row_t
  calls,rows,cols,last: INTEGER

ROUTINE make_named: matrix_t
VAR data: matrix_t
BEGIN
  calls=calls+1
  data[1,1]=1 data[1,2]=2 data[1,3]=3
  data[2,1]=4 data[2,2]=5 data[2,3]=6
  RETURN data
END make_named

ROUTINE make_fixed: ARRAY[2,COLUMNS] OF INTEGER
VAR data: ARRAY[2,COLUMNS] OF INTEGER
BEGIN
  calls=calls+1
  data[1,1]=10 data[1,2]=11 data[1,3]=12
  data[2,1]=13 data[2,2]=14 data[2,3]=15
  RETURN data
END make_fixed

ROUTINE echo(values: ARRAY[*,*] OF INTEGER): ARRAY[*,COLUMNS] OF INTEGER
BEGIN
  RETURN values
END echo

ROUTINE make_row: row_t
VAR data: row_t
BEGIN
  calls=calls+1
  data[1]=7 data[2]=8 data[3]=9
  RETURN data
END make_row

BEGIN
  calls=0
  named=make_named()
  fixed=make_fixed()
  wild=echo((fixed))
  row=make_row()
  last=make_named()[2,3]
  rows=ARRAY_LEN(named)
  cols=ARRAY_LEN(row)
  WRITE('rows=',rows,', cols=',cols,', last=',last,CR)
END pythonic_array_shapes
