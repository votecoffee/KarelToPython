PROGRAM PORT_CONFIG
%ENVIRONMENT IOSETUP
VAR
  rack,slot,physical_type,first_bit,bits,status: INTEGER
  initial_bit,active_mode,module_type: INTEGER
  staged_status: INTEGER
BEGIN
  GET_PORT_ASG(40,1,rack,slot,physical_type,first_bit,bits,status)
  initial_bit=first_bit
  IO_MOD_TYPE(rack,slot,module_type,status)
  SET_PORT_ASG(40,1,0,1,20,17,8,staged_status)
  SET_PORT_MOD(20,1,3,status)
  GET_PORT_ASG(40,1,rack,slot,physical_type,first_bit,bits,status)
  GET_PORT_MOD(20,1,active_mode,status)
END PORT_CONFIG
