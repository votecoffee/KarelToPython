PROGRAM ASSOCIATION_RECORD_PATHS
TYPE node_t=STRUCTURE common:COMMON_ASSOC axes:GROUP_ASSOC ENDSTRUCTURE
     header_t=STRUCTURE common:COMMON_ASSOC ENDSTRUCTURE
VAR track:PATH NODEDATA=node_t PATHHEADER=header_t status,node_bytes:INTEGER done:BOOLEAN
BEGIN
  IF UNINIT(done) THEN
    APPEND_NODE(track,status) READ(track) node_bytes=NODE_SIZE(track) done=TRUE
  ENDIF
END ASSOCIATION_RECORD_PATHS
