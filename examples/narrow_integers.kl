PROGRAM NARROW_INTEGERS
%NOLOCKGROUP
TYPE PACKET_T = STRUCTURE
  CODE: BYTE
  COUNT: SHORT
  PAYLOAD: ARRAY[2] OF BYTE
ENDSTRUCTURE
VAR
  BYTES, SAVED_BYTES: ARRAY[3] OF BYTE
  SHORTS: ARRAY[3] OF SHORT
  GRID: ARRAY[2,2] OF BYTE
  PACKET, SAVED_PACKET: PACKET_T
  VALUE_SEEN, SUM: INTEGER
  PROMOTED_VALUE: REAL
  SENTINEL_DETECTED: BOOLEAN
ROUTINE FILL(P: ARRAY OF BYTE)
VAR K: INTEGER
BEGIN
  FOR K = 1 TO ARRAY_LEN(P) DO
    P[K] = K * 10
  ENDFOR
END FILL
ROUTINE CHANGE_VALUE(P: INTEGER)
BEGIN
  VALUE_SEEN = P
  P = 99
END CHANGE_VALUE
ROUTINE PROMOTE(P: REAL)
BEGIN
  P = P + 0.5
  PROMOTED_VALUE = P
END PROMOTE
ROUTINE CHANGE_GRID(P: ARRAY[*,*] OF BYTE)
BEGIN
  P[2,1] = 255
END CHANGE_GRID
BEGIN
  FILL(BYTES)
  SAVED_BYTES = BYTES
  CHANGE_VALUE(BYTES[1])
  SHORTS[1] = -32768
  SHORTS[2] = 32766
  SHORTS[3] = 32767
  SENTINEL_DETECTED = UNINIT(SHORTS[3])
  PROMOTE(SHORTS[1])
  SUM = BYTES[1] + SHORTS[2]
  PACKET.CODE = BYTES[2]
  PACKET.COUNT = 123
  PACKET.PAYLOAD[1] = 254
  PACKET.PAYLOAD[2] = 0
  SAVED_PACKET = PACKET
  PACKET.CODE = 99
  CHANGE_GRID(GRID)
END NARROW_INTEGERS
