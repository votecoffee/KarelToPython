PROGRAM KCL_COLL_ROWS
TYPE node_t=STRUCTURE value:INTEGER ENDSTRUCTURE
     header_t=STRUCTURE count:INTEGER ENDSTRUCTURE
     route_t=PATH NODEDATA=node_t PATHHEADER=header_t
     routes_t=ARRAY[2,2]OF route_t
     queues_t=ARRAY[2,2]OF QUEUE_TYPE
VAR routes:routes_t
    queues:queues_t
    seen_routes:ARRAY[2]OF route_t
    seen_queues:ARRAY[2]OF QUEUE_TYPE
    buffers:ARRAY[2,2]OF INTEGER
    entry,status,sequence,path_status,queue_status,repeat_status:INTEGER
    done:BOOLEAN
BEGIN
  IF UNINIT(done) THEN
    routes[1,1].count=0 routes[1,2].count=0
    routes[2,1].count=0 routes[2,2].count=0
    APPEND_NODE(routes[1,1],status) routes[1,1][1].value=17 routes[1,1].count=1
    APPEND_NODE(routes[1,2],status) routes[1,2][1].value=19 routes[1,2].count=1
    INIT_QUEUE(queues[2,1]) INIT_QUEUE(queues[2,2])
    APPEND_QUEUE(31,queues[2,1],buffers[1],sequence,status)
    APPEND_QUEUE(37,queues[2,2],buffers[2],sequence,status)
    CREATE_VAR('','COPIED_ROUTES','','routes_t',0,0,0,0,status,-1)
    CREATE_VAR('','COPIED_QUEUES','','queues_t',0,0,0,0,status,-1)
    KCL('SET VAR COPIED_ROUTES[2]=ROUTES[1]',path_status)
    KCL('SET VAR COPIED_QUEUES[1]=QUEUES[2]',queue_status)
    KCL('SET VAR COPIED_ROUTES[1]=COPIED_ROUTES[2]',repeat_status)
    routes[1,2][1].value=99
    APPEND_QUEUE(99,queues[2,1],buffers[1],sequence,status)
    GET_VAR(entry,'','COPIED_ROUTES[2]',seen_routes,status)
    GET_VAR(entry,'','COPIED_QUEUES[1]',seen_queues,status)
    done=TRUE
  ENDIF
END KCL_COLL_ROWS
