PROGRAM LABEL_DEMO
%NOLOCKGROUP
VAR
  VISITS, TOTAL, ROUNDS, COUNTER, FACTORIAL_RESULT: INTEGER
  COUNTER_CLEARED, FINISHED: BOOLEAN
ROUTINE FACTORIAL(N: INTEGER): INTEGER
BEGIN
  IF N <= 1 THEN GO TO base_case ENDIF
  RETURN N * FACTORIAL(N - 1)
base_case:: RETURN 1
END FACTORIAL
BEGIN
  VISITS = 0
  TOTAL = 0
  ROUNDS = 0
again::
  VISITS = VISITS + 1
  SELECT VISITS OF
    CASE(1): TOTAL = TOTAL + 10
    CASE(2): TOTAL = TOTAL + 20
    ELSE: GO TO loops
  ENDSELECT
  GOTO again
loops::
  FOR COUNTER = 1 TO 2 DO
    TOTAL = TOTAL + COUNTER
  ENDFOR
  COUNTER_CLEARED = UNINIT(COUNTER)
  WHILE TRUE DO
    ROUNDS = ROUNDS + 1
    IF ROUNDS = 2 THEN GO TO finish_here ENDIF
  ENDWHILE
  TOTAL = 999
finish_here::
  FACTORIAL_RESULT = FACTORIAL(5)
  FINISHED = TRUE
END LABEL_DEMO
