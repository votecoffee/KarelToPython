PROGRAM HANDLER_PRIORITY
VAR trace:STRING[8] ready,done:BOOLEAN value:INTEGER
BEGIN
  IF UNINIT(done) THEN
    trace='' ready=FALSE
    CONDITION[9]: WITH $PRIORITY=80 WHEN ready DO trace=trace+'a' ENDCONDITION
    CONDITION[4]: WITH $PRIORITY=10 WHEN ready DO trace=trace+'b' ENDCONDITION
    CONDITION[5]: WHEN ready DO trace=trace+'c' ENDCONDITION
    ENABLE CONDITION[9] ENABLE CONDITION[4] ENABLE CONDITION[5]
    ready=TRUE value=0 value=STR_LEN(trace) done=TRUE
  ENDIF
END HANDLER_PRIORITY
