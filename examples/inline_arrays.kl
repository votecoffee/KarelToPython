PROGRAM INLINE_ARRAYS
TYPE grid_t=ARRAY[2] OF ARRAY[3] OF INTEGER
VAR values,copy:grid_t
    total:INTEGER
ROUTINE edit(data:ARRAY OF ARRAY OF INTEGER)
BEGIN
  data[2][3]=9
END edit
ROUTINE clone:ARRAY OF ARRAY[3] OF INTEGER
BEGIN
  RETURN values
END clone
BEGIN
  values[1,1]=1 values[1,2]=2 values[1,3]=3
  values[2,1]=4 values[2,2]=5 values[2,3]=6
  edit(values)
  copy=clone()
  values[2,3]=99
  total=copy[1,1]+copy[2,3]
  WRITE(copy::3,CR)
END INLINE_ARRAYS
