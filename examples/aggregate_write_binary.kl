PROGRAM AGGREGATE_WRITE_BINARY
TYPE packet_t=STRUCTURE values:ARRAY[2]OF INTEGER label:STRING[4] axes:JOINTPOS2 ENDSTRUCTURE
VAR packet:packet_t value:INTEGER done:BOOLEAN
ROUTINE work
VAR f:FILE
BEGIN
  packet.values[1]=7 packet.values[2]=9 packet.label='text'
  packet.axes[1]=2.5 packet.axes[2]=3.5
  OPEN FILE f('WB','output')
  WRITE f(packet)
  CLOSE FILE f
  packet.values[1]=99 packet.label='old' packet.axes[1]=88
  OPEN FILE f('RB','output')
  READ f(packet)
  CLOSE FILE f
  value=packet.values[1]+packet.values[2]
END work
BEGIN
  IF UNINIT(done) THEN work done=TRUE ENDIF
END AGGREGATE_WRITE_BINARY
