PROGRAM MAIN
TYPE node_t=STRUCTURE value:INTEGER ENDSTRUCTURE header_t=STRUCTURE count:INTEGER ENDSTRUCTURE route_t=PATH NODEDATA=node_t PATHHEADER=header_t
VAR target:ARRAY[2]OF route_t value:INTEGER done:BOOLEAN
ROUTINE work:INTEGER FROM LIB
BEGIN
  IF UNINIT(done) THEN value=work done=TRUE ENDIF
END MAIN
