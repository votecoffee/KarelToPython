PROGRAM check_positions
%ENVIRONMENT PBCORE
VAR
  target: XYZWPREXT
  frame,tool: POSITION
  cfg: CONFIG
  status,valid_status,unreachable_status,framed_status,external_status: INTEGER
BEGIN
  CNV_STR_CONF('N',cfg,status)
  frame=POS(0,0,0,0,0,0,cfg)
  tool=frame
  target=POS(100,0,0,0,0,0,cfg)
  CHECK_EPOS(target,frame,tool,valid_status)
  target.x=250
  CHECK_EPOS(target,frame,tool,unreachable_status)
  frame=POS(10,0,0,0,0,0,cfg)
  tool=POS(5,0,0,0,0,0,cfg)
  target.x=95
  CHECK_EPOS(target,frame,tool,framed_status)
  target.z=42
  target.ext1=42
  CHECK_EPOS(target,frame,tool,external_status,2)
END check_positions
