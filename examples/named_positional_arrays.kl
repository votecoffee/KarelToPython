PROGRAM NAMEDPOSES
TYPE angle_row=ARRAY[2]OF XYZWPR angle_grid=ARRAY[1]OF angle_row
     matrix_row=ARRAY[2]OF POSITION matrix_grid=ARRAY[1]OF matrix_row
     ext_row=ARRAY[2]OF XYZWPREXT ext_grid=ARRAY[1]OF ext_row
VAR cfg:CONFIG status:INTEGER a:angle_grid matrices:matrix_grid result:ext_grid done:BOOLEAN
ROUTINE shifted(points:matrix_grid):ext_grid
BEGIN
  points[1,1].location.x=points[1,1].location.x+10
  RETURN points
END shifted
BEGIN
  IF UNINIT(done) THEN
    CNV_STR_CONF('N',cfg,status)
    a[1,1]=POS(1,2,3,0,0,90,cfg)
    a[1,2]=POS(4,5,6,0,0,0,cfg)
    matrices=a
    result=shifted(a)
    done=TRUE
  ENDIF
END NAMEDPOSES
