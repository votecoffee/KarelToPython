PROGRAM SERIAL_ATTRIBUTES
%NOLOCKGROUP
%ENVIRONMENT FLBT
VAR
  status,read_ahead,baud,parity,stop_bits,data_bits,flow_control,eol: INTEGER
BEGIN
  status=SET_PORT_ATR(PORT_2,ATR_READAHD,2)
  status=SET_PORT_ATR(PORT_2,ATR_BAUD,BAUD_9600)
  status=SET_PORT_ATR(PORT_2,ATR_PARITY,PARITY_EVEN)
  status=SET_PORT_ATR(PORT_2,ATR_SBITS,SBITS_15)
  status=SET_PORT_ATR(PORT_2,ATR_DBITS,DBITS_8)
  status=SET_PORT_ATR(PORT_2,ATR_XONOFF,XF_USED)
  status=SET_PORT_ATR(PORT_2,ATR_EOL,10)
  status=GET_PORT_ATR(PORT_2,ATR_READAHD,read_ahead)
  status=GET_PORT_ATR(PORT_2,ATR_BAUD,baud)
  status=GET_PORT_ATR(PORT_2,ATR_PARITY,parity)
  status=GET_PORT_ATR(PORT_2,ATR_SBITS,stop_bits)
  status=GET_PORT_ATR(PORT_2,ATR_DBITS,data_bits)
  status=GET_PORT_ATR(PORT_2,ATR_XONOFF,flow_control)
  status=GET_PORT_ATR(PORT_2,ATR_EOL,eol)
END SERIAL_ATTRIBUTES
