PROGRAM MOTION_TWENTY_ONE_SETTINGS
VAR point,tool_frame:XYZWPR config_data:CONFIG status:INTEGER done:BOOLEAN
BEGIN
  IF UNINIT(done) THEN
    CNV_STR_CONF('N',config_data,status)
    point=POS(10,20,30,0,0,0,config_data)
    tool_frame=POS(40,50,60,0,0,0,config_data)
    ATTACH
    WITH $SPEED=25,$ROTSPEED=10,$MOTYPE=STRAIGHT,$UFRAME=point,$UTOOL=tool_frame,
         $USE_CONFIG=FALSE,$TERMTYPE=FINE,$SEGTERMTYPE=NOSETTLE,$ORIENT_TYPE=WRISTJOINT,
         $DECELTOL=75,$USEMAXACCEL=TRUE,
         $ACCEL_OVRD=125,$ACCU_NUM=3,$SEG_TIME=40,$TIME_SHIFT=10,$CONTAXISVEL=-25.5,$CNSTNT_PATH=TRUE,$DYN_I_COMP=FALSE,$USE_CARTACC=TRUE,$USERELACCEL=TRUE,$USETIMESHFT=TRUE
    MOVE TO point
    RELEASE
    done=TRUE
  ENDIF
END MOTION_TWENTY_ONE_SETTINGS
