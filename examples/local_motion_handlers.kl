PROGRAM LOCAL_MOTION_HANDLERS
VAR n:INTEGER done:BOOLEAN
BEGIN
  IF UNINIT(done) THEN
    n=0
    ATTACH
    MOVE AWAY 1,
      WHEN TRUE DO n=n+1
      WHEN n=1 DO
        OPEN HAND 1
        n=n+10
      UNTIL n=11 THEN n=n+100
    ENDMOVE
    RELEASE
    done=TRUE
  ENDIF
END LOCAL_MOTION_HANDLERS
