PROGRAM DYNAMIC_FILE_ARRAY_NESTED
TYPE row_t=ARRAY[2]OF FILE
VAR entry,status,value:INTEGER done:BOOLEAN
ROUTINE work(a:ARRAY OF FILE)
BEGIN
  OPEN FILE a[2]('WO','out') WRITE a[2](17) status=IO_STATUS(a[2]) CLOSE FILE a[2]
  value=17
END work
BEGIN
  IF UNINIT(done) THEN
    CREATE_VAR('CACHE','ITEM','','row_t',0,2,0,0,status)
    done=TRUE
  ENDIF
  work(BYNAME('CACHE','ITEM[2]',entry))
END DYNAMIC_FILE_ARRAY_NESTED
