PROGRAM MAIN
VAR status,elapsed:INTEGER done:BOOLEAN
ROUTINE transmit FROM LIB
ROUTINE exchange
BEGIN
 elapsed=0
 CONNECT TIMER TO elapsed
 CONDITION[1]: WHEN elapsed>=10 DO CANCEL FILE TPDISPLAY ENDCONDITION
 ENABLE CONDITION[1]
 transmit()
 status=IO_STATUS(TPDISPLAY)
 CLOSE FILE TPDISPLAY
 DISCONNECT TIMER elapsed
 elapsed=0
END exchange
BEGIN
 IF UNINIT(done) THEN exchange() done=TRUE ENDIF
END MAIN
