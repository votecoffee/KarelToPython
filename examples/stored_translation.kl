PROGRAM STORED_TRANSLATION
VAR output_file:FILE names:ARRAY[1] OF STRING[32]
    header:STRING[120] translation_status,count,status:INTEGER
    python_header:BOOLEAN
BEGIN
  TRANSLATE('child',TRUE,translation_status)
  FILE_LIST('*.py',0,3,names,count,status)
  OPEN FILE output_file('RO','child.py')
  READ output_file(header,CR)
  CLOSE FILE output_file
  python_header=INDEX(header,'# Generated by karel2py ')=1
  header=''
  DELETE_FILE('child.py',FALSE,status)
  DELETE_FILE('child.LS',FALSE,status)
END STORED_TRANSLATION
