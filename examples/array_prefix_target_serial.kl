PROGRAM ARRAY_PREFIX_TARGET_SERIAL
VAR matrix:ARRAY[2,2]OF INTEGER value:INTEGER done:BOOLEAN
ROUTINE work
VAR f:FILE
BEGIN
  OPEN FILE f('RO','P2:') READ f(matrix[2]::2::16,CR) CLOSE FILE f
  value=matrix[2,1]+matrix[2,2]
END work
BEGIN IF UNINIT(done) THEN work done=TRUE ENDIF END ARRAY_PREFIX_TARGET_SERIAL
