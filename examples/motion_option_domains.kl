PROGRAM MOTION_OPTION_DOMAINS
VAR done:BOOLEAN
BEGIN
  IF UNINIT(done) THEN
    ATTACH
    WITH $ACCEL_OVRD=125,$ACCU_NUM=3,$SEG_TIME=40,$TIME_SHIFT=10,$CONTAXISVEL=-25.5,$CNSTNT_PATH=TRUE,$DYN_I_COMP=FALSE,$USE_CARTACC=TRUE,$USERELACCEL=TRUE,$USETIMESHFT=TRUE
    MOVE AWAY 1
    RELEASE
    done=TRUE
  ENDIF
END MOTION_OPTION_DOMAINS
