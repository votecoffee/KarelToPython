PROGRAM MAIN
TYPE node_t=STRUCTURE value:INTEGER ENDSTRUCTURE route_t=PATH NODEDATA=node_t
VAR source,target:route_t status:INTEGER done:BOOLEAN
ROUTINE work(values:route_t):route_t FROM LIB
BEGIN
  IF UNINIT(done) THEN APPEND_NODE(source,status) source[1].value=17 target=work((source)) done=TRUE ENDIF
END MAIN
