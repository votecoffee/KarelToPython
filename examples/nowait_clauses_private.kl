PROGRAM NOWAIT_CLAUSES_PRIVATE
TYPE item_t=STRUCTURE amount:INTEGER ENDSTRUCTURE
VAR item:item_t n:INTEGER done:BOOLEAN
ROUTINE copy_item:item_t BEGIN RETURN item END copy_item
BEGIN
 IF UNINIT(done) THEN
  n=0 ATTACH
  USING copy_item() DO
   amount=7
   MOVE AWAY 1 NOWAIT,
    WHEN AT NODE[1] DO n=amount
   ENDMOVE
  ENDUSING
  item.amount=9 DELAY 40
  RELEASE done=TRUE
 ENDIF
END NOWAIT_CLAUSES_PRIVATE
