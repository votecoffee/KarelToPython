PROGRAM pythonic_strings
VAR
  original: STRING[8]
  decorated,generated,formatted: STRING[16]
  clipped: STRING[4]
  label_length: INTEGER

ROUTINE base_name: STRING
BEGIN
  RETURN 'robot'
END base_name

ROUTINE decorate(value: STRING): STRING
BEGIN
  value='['+value+']'
  RETURN value
END decorate

ROUTINE short_label: STRING[4]
BEGIN
  RETURN 'abcdef'
END short_label

ROUTINE format_value(value: STRING)
BEGIN
  CNV_REAL_STR(0.125,1,3,value)
  formatted=value
END format_value

BEGIN
  original='seed'
  decorated=decorate((original))
  generated=decorate(base_name())
  clipped=short_label
  label_length=STR_LEN(base_name())
  format_value('placeholder')
  WRITE('original=',original,', decorated=',decorated,CR)
  WRITE('generated=',generated,', clipped=',clipped,', formatted=',formatted,CR)
END pythonic_strings
