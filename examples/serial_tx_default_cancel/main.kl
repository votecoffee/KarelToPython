PROGRAM MAIN
VAR n,s,elapsed:INTEGER done:BOOLEAN
ROUTINE work FROM LIB
ROUTINE run_job
VAR f:FILE
BEGIN
 elapsed=0
 CONNECT TIMER TO elapsed
 CONDITION[1]: WHEN elapsed>=10 DO CANCEL FILE TPDISPLAY ENDCONDITION
 ENABLE CONDITION[1]
 work()
 s=IO_STATUS(TPDISPLAY)
 CLOSE FILE TPDISPLAY
 DISCONNECT TIMER elapsed
 elapsed=0
END run_job
BEGIN
 IF UNINIT(done) THEN run_job() n=7 done=TRUE ENDIF
END MAIN
