PROGRAM MAIN
VAR status,elapsed:INTEGER done:BOOLEAN
ROUTINE relinquish FROM LIB
ROUTINE exchange
BEGIN
 elapsed=0
 LOCK_GROUP(3,status)
 CONNECT TIMER TO elapsed
 CONDITION[1]:
  WHEN elapsed>=25 DO CNCL_STP_MTN DISABLE CONDITION[1]
 ENDCONDITION
 ENABLE CONDITION[1]
 relinquish()
 DISCONNECT TIMER elapsed
 elapsed=0
END exchange
BEGIN
 IF UNINIT(done) THEN exchange() done=TRUE ENDIF
END MAIN
