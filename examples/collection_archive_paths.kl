PROGRAM COLLECTION_ARCHIVE_PATHS
TYPE node_t=STRUCTURE value:INTEGER ENDSTRUCTURE header_t=STRUCTURE count:INTEGER ENDSTRUCTURE route_t=PATH NODEDATA=node_t PATHHEADER=header_t
VAR routes:ARRAY[2]OF route_t value:INTEGER done:BOOLEAN
ROUTINE transact
VAR status,seq:INTEGER
BEGIN
  APPEND_NODE(routes[2],status) routes[2][1].value=17 routes[2].count=1 SAVE('COLLECTION_ARCHIVE_PATHS','COLLECTION_ARCHIVE_PATHS.VR',status) routes[2][1].value=99 CLEAR('COLLECTION_ARCHIVE_PATHS.VR',status) LOAD('COLLECTION_ARCHIVE_PATHS.VR',0,status) value=routes[2][1].value
END transact
BEGIN
  IF UNINIT(done) THEN
    transact
    done=TRUE
  ENDIF
END COLLECTION_ARCHIVE_PATHS
