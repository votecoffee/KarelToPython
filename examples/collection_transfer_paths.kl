PROGRAM COLLECTION_TRANSFER_PATHS
TYPE node_t=STRUCTURE value:INTEGER ENDSTRUCTURE header_t=STRUCTURE count:INTEGER ENDSTRUCTURE route_t=PATH NODEDATA=node_t PATHHEADER=header_t
VAR source,target:ARRAY[2]OF route_t entry,status,value:INTEGER done:BOOLEAN
BEGIN
  IF UNINIT(done) THEN
    source[1].count=0 source[2].count=1 APPEND_NODE(source[2],status) source[2][1].value=17 GET_VAR(entry,'','SOURCE',target,status) source[2][1].value=99 value=target[2][1].value
    done=TRUE
  ENDIF
END COLLECTION_TRANSFER_PATHS
