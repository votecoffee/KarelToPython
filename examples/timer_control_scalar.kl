PROGRAM TIMER_CONTROL_SCALAR
VAR elapsed:INTEGER ready,done:BOOLEAN
ROUTINE stop_timer(value:INTEGER):BOOLEAN BEGIN DISCONNECT TIMER value RETURN value>0 END stop_timer
BEGIN
 IF UNINIT(done) THEN
  CONNECT TIMER TO elapsed DELAY 32 ready=stop_timer(elapsed)
  elapsed=0 DELAY 9 done=TRUE
 ENDIF
END TIMER_CONTROL_SCALAR
