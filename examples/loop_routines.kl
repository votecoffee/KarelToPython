PROGRAM LOOP_ROUTINES
%NOLOCKGROUP
VAR
  VALUES: ARRAY[4] OF INTEGER
  INITIAL_SEARCH, FIRST_ZERO, TOTAL: INTEGER
  COUNTERS_CLEARED: BOOLEAN
ROUTINE DOUBLE_VALUE(N: INTEGER): INTEGER
BEGIN
  RETURN N * 2
END DOUBLE_VALUE
ROUTINE IS_ZERO(N: INTEGER): BOOLEAN
BEGIN
  RETURN N = 0
END IS_ZERO
ROUTINE FILL_VALUES(TABLE: ARRAY OF INTEGER)
VAR K: INTEGER
BEGIN
  FOR K = 1 TO ARRAY_LEN(TABLE) DO
    TABLE[K] = DOUBLE_VALUE((K))
  ENDFOR
END FILL_VALUES
ROUTINE FIND_ZERO(TABLE: ARRAY OF INTEGER): INTEGER
VAR K: INTEGER
BEGIN
  FOR K = 1 TO ARRAY_LEN(TABLE) DO
    IF IS_ZERO(TABLE[K]) THEN RETURN K ENDIF
  ENDFOR
  RETURN 0
END FIND_ZERO
ROUTINE ADD_VALUE(N: INTEGER)
BEGIN
  TOTAL = TOTAL + N
  N = 99
END ADD_VALUE
ROUTINE SUM_COUNTERS
VAR K: INTEGER
BEGIN
  FOR K = 1 TO 3 DO
    ADD_VALUE((K))
  ENDFOR
  COUNTERS_CLEARED = UNINIT(K)
END SUM_COUNTERS
BEGIN
  FILL_VALUES(VALUES)
  INITIAL_SEARCH = FIND_ZERO(VALUES)
  VALUES[3] = 0
  FIRST_ZERO = FIND_ZERO(VALUES)
  TOTAL = 0
  SUM_COUNTERS
END LOOP_ROUTINES
