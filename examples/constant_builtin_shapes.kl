PROGRAM CONSTANT_BUILTIN_SHAPES
CONST c_count=ROUND(SQRT(c_square)) c_square=9 c_label=SUB_STR('READY!',1,5)
TYPE row_t=ARRAY[c_count]OF INTEGER
VAR row:row_t text:STRING[STR_LEN(c_label)] answer:INTEGER
ROUTINE make:row_t
VAR local:row_t
CONST c_step=ABS(-7)
BEGIN
  local[1]=c_step local[2]=c_step+1 local[3]=c_step+2
  RETURN local
END make
BEGIN
  row=make text=SUB_STR(c_label,1,3)
  answer=row[1]+row[2]+row[3]
END CONSTANT_BUILTIN_SHAPES
