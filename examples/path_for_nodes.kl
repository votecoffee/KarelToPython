PROGRAM PATH_FOR_NODES
TYPE data_t=STRUCTURE count:INTEGER other:INTEGER ENDSTRUCTURE route_t=PATH NODEDATA=data_t PATHHEADER=data_t
VAR source:route_t total,status,slot,visits:INTEGER done:BOOLEAN
ROUTINE pick:INTEGER BEGIN visits=visits+1 RETURN slot END pick
BEGIN
 IF UNINIT(done) THEN
  APPEND_NODE(source,status) APPEND_NODE(source,status) source[1].other=11 source[2].other=22 slot=1 visits=0 total=0 FOR source[pick()].count=1 TO 3 DO slot=2 total=total+source[1].count ENDFOR
  done=TRUE
 ENDIF
END PATH_FOR_NODES
