PROGRAM COLLECTION_TRANSFER_PARTIAL
TYPE node_t=STRUCTURE value:INTEGER ENDSTRUCTURE header_t=STRUCTURE count:INTEGER ENDSTRUCTURE route_t=PATH NODEDATA=node_t PATHHEADER=header_t
VAR source,target:ARRAY[2]OF route_t entry,status:INTEGER done:BOOLEAN
BEGIN
  IF UNINIT(done) THEN
    APPEND_NODE(source[2],status) source[2].count=1 SET_VAR(entry,'','TARGET',source,status)
    done=TRUE
  ENDIF
END COLLECTION_TRANSFER_PARTIAL
