PROGRAM LIB
ROUTINE take(values:ARRAY OF INTEGER):INTEGER
VAR f:FILE status,elapsed:INTEGER
BEGIN
  elapsed=0
  CONNECT TIMER TO elapsed
  CONDITION[1]: WHEN elapsed>=10 DO CANCEL FILE f ENDCONDITION
  ENABLE CONDITION[1]
  OPEN FILE f('RO','P2:')
  READ f(values,CR)
  DISABLE CONDITION[1]
  status=IO_STATUS(f)
  CLOSE FILE f
  DISCONNECT TIMER elapsed
  RETURN status
END take
BEGIN END LIB
