PROGRAM MAIN
VAR matrix:ARRAY[2,3]OF INTEGER value,entry,status:INTEGER done:BOOLEAN
ROUTINE total:INTEGER FROM LIB
BEGIN
  IF UNINIT(done) THEN
    matrix[1,1]=7 matrix[1,2]=9 matrix[1,3]=11
    CREATE_VAR('CACHE','GRID','','INTEGER',0,3,2,0,status)
    SET_VAR(entry,'CACHE','GRID[2]',matrix[1],status)
    value=total() done=TRUE
  ENDIF
END MAIN
