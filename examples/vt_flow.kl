PROGRAM VT_FLOW
VAR
  status,model_no,work_id,wait_ms,frame_no:INTEGER
  cfg:CONFIG
  offset,result_pose:XYZWPR
  positions:ARRAY[4] OF XYZWPR
  measures:ARRAY[10] OF REAL
  duplicate:BOOLEAN
  note:STRING[40]
BEGIN
  CNV_STR_CONF('N',cfg,status)
  offset=POS(1,2,3,0,0,0,cfg)
  positions[2]=offset
  measures[1]=1.25
  measures[3]=3.75
  VT_PUT_QUEUE(1,101,0,100,7,offset,positions,measures,status)
  VT_PUT_QUE2(1,101,0,100,7,offset,positions,measures,duplicate,status)
  -- Unknown INTEGER selectors select any model/work ID; zero would select zero.
  VT_GET_TIME(1,1,model_no,work_id,wait_ms,status)
  VT_GET_QUEUE(1,1,20,1,model_no,work_id,status)
  V_ADJ_2D(1,4,0,status)
  -- Not handled here: forward the adjusted result to the downstream area.
  VT_ACK_QUEUE(1,1,2,status)
  VT_GET_QUEUE(2,1,0,1,model_no,work_id,status)
  status=IRVU_VRGETOFFSET(1,result_pose,frame_no,note)
  VT_ACK_QUEUE(2,1,1,status)
  VT_CLR_QUEUE(1,status)
END VT_FLOW
