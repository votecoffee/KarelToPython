PROGRAM select_cases
%NOLOCKGROUP
CONST first_value = 2
VAR first_match,empty_match,empty_else,nested_result: INTEGER
    visits,loop_visits,chosen_result: INTEGER

ROUTINE choose: INTEGER
BEGIN
  visits = visits + 1
  RETURN first_value
END choose

ROUTINE find: INTEGER
VAR counter: INTEGER
BEGIN
  FOR counter = 1 TO 3 DO
    SELECT counter OF
    CASE(1):
    CASE(2): RETURN 7
    ELSE:
    ENDSELECT
  ENDFOR
  RETURN 9
END find

BEGIN
  visits = 0
  SELECT choose() OF
  CASE(1,first_value): first_match = 7
  CASE(first_value): first_match = 9
  ELSE: first_match = 11
  ENDSELECT

  empty_match = 5
  SELECT 2 OF
  CASE(2):
  CASE(2): empty_match = 9
  ENDSELECT

  empty_else = 13
  SELECT 9 OF
  CASE(1): empty_else = 1
  ELSE:
  ENDSELECT

  SELECT MAXINT OF
  CASE(MAXINT):
    SELECT MININT OF
    CASE(MININT): nested_result = 17
    CASE(MININT): nested_result = 19
    ENDSELECT
  ELSE: nested_result = 21
  ENDSELECT

  loop_visits = 0
again::
  loop_visits = loop_visits + 1
  SELECT loop_visits OF
  CASE(1,2): GOTO again
  CASE(3): chosen_result = find()
  ELSE: chosen_result = 11
  ENDSELECT
END select_cases
