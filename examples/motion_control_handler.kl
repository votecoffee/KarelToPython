PROGRAM MOTION_CONTROL_HANDLER
VAR status,n:INTEGER done:BOOLEAN
BEGIN
  IF UNINIT(done) THEN
    n=0
    CONDITION[1]:
      WHEN n=1 DO
        HOLD GROUP[1]
        CLOSE HAND 1
        CANCEL GROUP[1]
        UNHOLD GROUP[1]
    ENDCONDITION
    ENABLE CONDITION[1]
    LOCK_GROUP(1,status)
    n=1
    done=TRUE
  ENDIF
END MOTION_CONTROL_HANDLER
