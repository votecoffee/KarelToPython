PROGRAM LOCALREAD
VAR ready,done:BOOLEAN
ROUTINE retain_clock
VAR elapsed:INTEGER
BEGIN
  elapsed=7
  CONNECT TIMER TO elapsed
  CONDITION[1]:
    WHEN EVENT[1] DO ready=elapsed>=7
  ENDCONDITION
END retain_clock
BEGIN
  IF UNINIT(done) THEN
    ready=FALSE
    retain_clock()
    ENABLE CONDITION[1]
    SIGNAL EVENT[1]
    PURGE CONDITION[1]
    done=TRUE
  ENDIF
END LOCALREAD
