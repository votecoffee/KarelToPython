PROGRAM LIB
TYPE int_row=ARRAY[2]OF INTEGER int_grid=ARRAY[2]OF int_row
     short_row=ARRAY[2]OF SHORT short_grid=ARRAY[2]OF short_row
     real_row=ARRAY[2]OF REAL real_grid=ARRAY[2]OF real_row
VAR seen:short_grid
ROUTINE convert(values:short_grid):real_grid
BEGIN
  seen=values
  values[1,1]=7
  RETURN values
END convert
BEGIN
END LIB
