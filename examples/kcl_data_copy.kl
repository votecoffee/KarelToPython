PROGRAM KCL_DATA_COPY
VAR source,result:ARRAY[2,2]OF INTEGER entry,status:INTEGER
BEGIN
 source[1,1]=1 source[1,2]=2 source[2,1]=3 source[2,2]=4
 KCL('CREATE VAR [CACHE]GRID:ARRAY[2,2] OF INTEGER',status)
 KCL('SET VAR [CACHE]GRID=[KCL_DATA_COPY]SOURCE',status)
 source[2,2]=99
 GET_VAR(entry,'CACHE','GRID',result,status)
END KCL_DATA_COPY
