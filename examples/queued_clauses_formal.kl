PROGRAM QUEUED_CLAUSES_FORMAL
VAR n,s:INTEGER done:BOOLEAN
ROUTINE work(value:INTEGER)
BEGIN
  MOVE AWAY 2 NOWAIT,
   WHEN TRUE DO value=7
  ENDMOVE
  MOVE AWAY 3
 s=value
END work
BEGIN
 IF UNINIT(done) THEN
  n=0
  ATTACH
  MOVE AWAY 1 NOWAIT
  work(n)
  RELEASE
  done=TRUE
 ENDIF
END QUEUED_CLAUSES_FORMAL
