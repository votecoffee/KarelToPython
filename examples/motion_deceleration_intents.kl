PROGRAM MOTION_DECELERATION_INTENTS
VAR tolerance:INTEGER fast,done:BOOLEAN
BEGIN
  IF UNINIT(done) THEN
    tolerance=50 fast=TRUE
    ATTACH
    WITH $GROUP[1].$DECELTOL=tolerance,$USEMAXACCEL=fast
    MOVE AWAY 10
    WITH $DECELTOL=0,$USEMAXACCEL=FALSE
    MOVE AWAY 5
    RELEASE
    done=TRUE
  ENDIF
END MOTION_DECELERATION_INTENTS
