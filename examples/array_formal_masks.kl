PROGRAM ARRAY_FORMAL_MASKS
CONST c_rows=ROUND(2.5)
VAR grid:ARRAY[2,3]OF INTEGER columns,seen:INTEGER
ROUTINE fill(p:ARRAY[c_rows,*]OF INTEGER)
BEGIN
  columns=ARRAY_LEN(p,2)
  p[1,1]=7 p[1,2]=8 p[1,3]=9
  p[2,1]=10 p[2,2]=11 p[2,3]=12
END fill
ROUTINE private_edit(p:ARRAY[2,3]OF INTEGER)
BEGIN p[1,1]=100 seen=p[1,1] END private_edit
BEGIN fill(grid) private_edit((grid)) END ARRAY_FORMAL_MASKS
