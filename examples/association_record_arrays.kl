PROGRAM ASSOCIATION_RECORD_ARRAYS
VAR axes:ARRAY[2,2]OF GROUP_ASSOC entry:INTEGER done:BOOLEAN
ROUTINE fill(row:ARRAY OF GROUP_ASSOC)
BEGIN row[2].segrelspeed=50 END fill
BEGIN
  IF UNINIT(done) THEN
    axes[2,1].segmotype=7 fill(BYNAME('','AXES[2]',entry)) done=TRUE
  ENDIF
END ASSOCIATION_RECORD_ARRAYS
