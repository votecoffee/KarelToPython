PROGRAM EXTERNAL_LOGICAL_PATH_CASES
TYPE node_t=STRUCTURE id:INTEGER octet:BYTE ENDSTRUCTURE header_t=STRUCTURE tag:INTEGER ENDSTRUCTURE route_t=PATH NODEDATA=node_t PATHHEADER=header_t
VAR n:route_t status:INTEGER done:BOOLEAN
ROUTINE fill(value:route_t;status:INTEGER) FROM HOST
BEGIN
  IF UNINIT(done) THEN fill(n,status) done=TRUE ENDIF
END EXTERNAL_LOGICAL_PATH_CASES
