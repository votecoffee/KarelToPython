PROGRAM PATH_FOR_HEADER
TYPE data_t=STRUCTURE count:INTEGER other:INTEGER ENDSTRUCTURE route_t=PATH NODEDATA=data_t PATHHEADER=data_t
VAR source:route_t total:INTEGER missing,done:BOOLEAN

BEGIN
 IF UNINIT(done) THEN
  source.other=9 total=0 FOR source.count=1 TO 3 DO total=total+source.count ENDFOR missing=UNINIT(source.count)
  done=TRUE
 ENDIF
END PATH_FOR_HEADER
