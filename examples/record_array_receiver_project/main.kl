PROGRAM MAIN
TYPE in_t=STRUCTURE count:INTEGER label:STRING[8] ENDSTRUCTURE out_t=STRUCTURE label:STRING[3] count:REAL ENDSTRUCTURE row_t=ARRAY[2]OF out_t
VAR original:ARRAY[1,2]OF in_t result:ARRAY[1]OF row_t done:BOOLEAN
ROUTINE copy(dst:ARRAY[*,*]OF out_t;src:ARRAY[*,*]OF in_t) FROM LIB
BEGIN
  IF UNINIT(done) THEN
    original[1,1].count=7 original[1,1].label='abcdefgh'
    original[1,2].count=8 original[1,2].label='xy'
    copy(result,original)
    done=TRUE
  ENDIF
END MAIN
