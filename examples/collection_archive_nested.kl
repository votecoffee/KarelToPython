PROGRAM COLLECTION_ARCHIVE_NESTED
TYPE node_t=STRUCTURE value:INTEGER ENDSTRUCTURE header_t=STRUCTURE count:INTEGER ENDSTRUCTURE route_t=PATH NODEDATA=node_t PATHHEADER=header_t row_t=ARRAY[2]OF route_t
VAR banks:ARRAY[2]OF row_t value:INTEGER done:BOOLEAN
ROUTINE transact
VAR status,seq:INTEGER
BEGIN
  APPEND_NODE(banks[2,1],status) banks[2,1][1].value=31 banks[2,1].count=1 SAVE('COLLECTION_ARCHIVE_NESTED','COLLECTION_ARCHIVE_NESTED.VR',status) banks[2,1][1].value=99 LOAD('COLLECTION_ARCHIVE_NESTED.VR',0,status) value=banks[2,1][1].value
END transact
BEGIN
  IF UNINIT(done) THEN
    transact
    done=TRUE
  ENDIF
END COLLECTION_ARCHIVE_NESTED
