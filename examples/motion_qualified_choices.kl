PROGRAM MOTION_QUALIFIED_CHOICES
VAR n:INTEGER done:BOOLEAN
ROUTINE group_no:INTEGER BEGIN n=n*10+1 RETURN 1 END group_no
ROUTINE choice:INTEGER BEGIN n=n*10+2 RETURN 2 END choice
ROUTINE distance:REAL BEGIN n=n*10+3 RETURN 5.0 END distance
BEGIN
  IF UNINIT(done) THEN
    n=0
    ATTACH
    WITH $GROUP[group_no()].$TERMTYPE=choice(),$SEGTERMTYPE[1]=FINE,$ORIENT_TYPE=WRISTJOINT
    MOVE AWAY distance()
    RELEASE
    done=TRUE
  ENDIF
END MOTION_QUALIFIED_CHOICES
