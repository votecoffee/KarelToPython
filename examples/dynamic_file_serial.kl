PROGRAM DYNAMIC_FILE_SERIAL
VAR entry,status,value:INTEGER done:BOOLEAN
ROUTINE work(handle:FILE)
BEGIN
  OPEN FILE handle('RO','P2:')
  READ handle(value,CR)
  status=IO_STATUS(handle)
  CLOSE FILE handle
END work
BEGIN
  IF UNINIT(done) THEN
    CREATE_VAR('CACHE','FILE_DATA','','FILE',0,0,0,0,status)
    work(BYNAME('CACHE','FILE_DATA',entry))
    done=TRUE
  ENDIF
END DYNAMIC_FILE_SERIAL
