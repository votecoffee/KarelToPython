PROGRAM COLLECTION_VALUE_PATHS
TYPE node_t=STRUCTURE value:INTEGER ENDSTRUCTURE route_t=PATH NODEDATA=node_t
VAR source,target:ARRAY[2]OF route_t status:INTEGER done:BOOLEAN

BEGIN
  IF UNINIT(done) THEN
    APPEND_NODE(source[2],status) source[2][1].value=17 target=source source[2][1].value=99
    done=TRUE
  ENDIF
END COLLECTION_VALUE_PATHS
