PROGRAM JOINTARRAY
VAR a:ARRAY[2]OF JOINTPOS2 wide:ARRAY[2]OF JOINTPOS9 result:ARRAY[2]OF JOINTPOS4 narrow:ARRAY[2]OF JOINTPOS2 done:BOOLEAN
ROUTINE copied(points:ARRAY OF JOINTPOS9):ARRAY OF JOINTPOS4
BEGIN
  RETURN points
END copied
BEGIN
  IF UNINIT(done) THEN
    wide=a
    result=copied(a)
    narrow=result
    done=TRUE
  ENDIF
END JOINTARRAY
