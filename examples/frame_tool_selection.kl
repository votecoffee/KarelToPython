PROGRAM FRAME_TOOL_SELECTION
VAR before_frame,before_tool,frame_id,tool_id,value:INTEGER
BEGIN
  $MNUFRAMENUM[1]=2 $MNUTOOLNUM[1]=3
  before_frame=$MNUFRAMENUM[1] before_tool=$MNUTOOLNUM[1]
  $MNUFRAMENUM[1]=0 $MNUTOOLNUM[1]=0
  frame_id=$MNUFRAMENUM[1] tool_id=$MNUTOOLNUM[1]
  value=before_frame+before_tool
END FRAME_TOOL_SELECTION
