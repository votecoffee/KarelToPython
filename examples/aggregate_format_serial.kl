PROGRAM AGGREGATE_FORMAT_SERIAL
VAR values:ARRAY[2]OF INTEGER value:INTEGER done:BOOLEAN
ROUTINE work
VAR f:FILE
BEGIN
  OPEN FILE f('RO','P2:')
  READ f(values::2::16,CR)
  CLOSE FILE f
  value=values[1]+values[2]
END work
BEGIN
  IF UNINIT(done) THEN work done=TRUE ENDIF
END AGGREGATE_FORMAT_SERIAL
