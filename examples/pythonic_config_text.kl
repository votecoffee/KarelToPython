PROGRAM PYTHONIC_CONFIG_TEXT
VAR cfg,saved: CONFIG pose: XYZWPR
text: STRING[40] code,fail_code: INTEGER
ROUTINE decode(value: STRING; target: CONFIG; result: INTEGER)
BEGIN
  CNV_STR_CONF(value,target,result)
END decode
BEGIN
  decode('t u f, -1, 0, 2',cfg,code)
  saved=cfg
  CNV_CONF_STR(cfg,text)
  pose=POS(1.25,-2,.5,10,20,30,cfg)
  CNV_STR_CONF('N F',cfg,fail_code)
  IF fail_code<>0 THEN WRITE(text,CR) ENDIF
END PYTHONIC_CONFIG_TEXT
