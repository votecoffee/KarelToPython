PROGRAM VARIABLE_BACKUP_DEMO
VAR
  done: BOOLEAN
  status, entry, value: INTEGER
  text: STRING[8]
BEGIN
  IF UNINIT(done) THEN done=FALSE ENDIF
  IF NOT done THEN
    PROG_BACKUP('FR:variables/ROOT',PBR_VRTYPE,0,TRUE,status)
    IF status=0 THEN
      PROG_CLEAR('ROOT',PBR_VRTYPE,status)
      IF status=0 THEN
        PROG_RESTORE('FR:variables/ROOT.VR',status)
        IF status=0 THEN done=TRUE ENDIF
      ENDIF
    ENDIF
  ENDIF
  GET_VAR(entry,'ROOT','VALUE',value,status)
  GET_VAR(entry,'CHILD','TEXT',text,status)
END VARIABLE_BACKUP_DEMO
