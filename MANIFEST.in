include LICENSE README.md CONTRIBUTING.md AGENTS.md CHANGELOG.md
recursive-include docs *.md *.json
recursive-include examples *.kl *.json *.input.txt
recursive-include tests *.py
recursive-include tools *.py *.md
prune .local
prune work
prune outputs
prune build
prune dist
global-exclude *.py[cod] *.report.json
